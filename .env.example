# ─── Supabase (banco de dados de precificação) ──────────────────────────────
# Pegar em Supabase → Project Settings → API
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ─── Autenticação do time ───────────────────────────────────────────────────
# Senha que cada membro do time vai digitar na tela de login
TEAM_PASSWORD=troque-esta-senha

# Chave aleatória usada para assinar o cookie de sessão (32+ caracteres)
# Gere com: openssl rand -base64 32
AUTH_SECRET=cole-aqui-uma-string-aleatoria-longa
